---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { getLocalePath } from '../config/i18n';
import { useTranslations } from '../i18n/utils';

const locale = 'pt-br';
const t = useTranslations(locale);
const homeHref = getLocalePath(locale, '/');
---

<BaseLayout title="404" description={t('notFound.title')} locale={locale} noindex>
  <section class="py-20">
    <p class="text-primary text-sm font-medium">404</p>
    <h1 class="mt-3 text-4xl font-bold">{t('notFound.title')}</h1>
    <p class="text-muted-foreground mt-4">{t('notFound.description')}</p>
    <a
      href={homeHref}
      class="bg-primary text-primary-foreground mt-8 inline-flex rounded-[var(--radius-control)] px-4 py-2"
      >{t('notFound.action')}</a
    >
  </section>
</BaseLayout>
