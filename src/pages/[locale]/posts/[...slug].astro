---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import Breadcrumbs from '../../../components/content/Breadcrumbs.astro';
import PostMeta from '../../../components/content/PostMeta.astro';
import PostLicense from '../../../components/content/PostLicense.astro';
import PostNavigation from '../../../components/content/PostNavigation.astro';
import RelatedPosts from '../../../components/content/RelatedPosts.astro';
import { contentTypes } from '../../../config/content';
import { getLocalePath, locales, type Locale } from '../../../config/i18n';
import { siteConfig } from '../../../config/site';
import { adjacentEntries, getLocalizedEntries, entrySlug, relatedPosts } from '../../../lib/content/entries';
import { estimateReadingMinutes } from '../../../lib/content/reading-time';
import { getSeriesContext, localizedSeriesPath } from '../../../lib/content/series';

export async function getStaticPaths() {
  const paths = [];
  for (const locale of locales.filter((item) => item !== 'pt-br')) {
    const posts = await getLocalizedEntries('posts', locale);
    paths.push(...posts.map((entry) => ({ params: { locale, slug: entrySlug(entry as any) }, props: { entry, locale } })));
  }
  return paths;
}

const { entry, locale } = Astro.props as any as { entry: any; locale: Locale };
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const hasMath = Boolean(entry.data.math || remarkPluginFrontmatter.math);
const readingMinutes = estimateReadingMinutes(entry.body || '');
const posts = await getLocalizedEntries('posts', locale);
const currentSlug = entrySlug(entry as CollectionEntry<'posts'>);
const availableLocales: Locale[] = [];
for (const candidateLocale of locales) {
  const candidates = candidateLocale === locale ? posts : await getLocalizedEntries('posts', candidateLocale);
  if (candidates.some((candidate) => entrySlug(candidate as CollectionEntry<'posts'>) === currentSlug)) {
    availableLocales.push(candidateLocale);
  }
}
const seriesContext = await getSeriesContext(entry);
const adjacent: {
  previous?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
} = seriesContext
  ? {
      previous: seriesContext.previous as CollectionEntry<'posts'> | undefined,
      next: seriesContext.next as CollectionEntry<'posts'> | undefined
    }
  : adjacentEntries(posts, entry as CollectionEntry<'posts'>) as {
      previous?: CollectionEntry<'posts'>;
      next?: CollectionEntry<'posts'>;
    };
const related = relatedPosts(posts, entry, siteConfig.post.relatedCount);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  locale={locale}
  availableLocales={availableLocales}
  type="article"
  image={entry.data.cover}
  imageAlt={entry.data.coverAlt || entry.data.title}
  publishedTime={entry.data.pubDate}
  modifiedTime={entry.data.updatedDate}
  author={entry.data.author ? { name: entry.data.author, url: entry.data.authorUrl } : undefined}
  tags={entry.data.tags}
  categories={entry.data.categories}
  breadcrumbs={[
    { name: siteConfig.shortName, item: getLocalePath(locale, '/') },
    { name: contentTypes.posts.label[locale], item: getLocalePath(locale, contentTypes.posts.path) },
    { name: entry.data.title }
  ]}
  headings={headings}
  toc={entry.data.toc ?? 'center'}
  comments={entry.data.comments}
  math={hasMath}
>
  <Breadcrumbs
    locale={locale}
    items={[
      { label: siteConfig.shortName, href: getLocalePath(locale, '/'), icon: 'lucide:home' },
      { label: contentTypes.posts.label[locale], href: getLocalePath(locale, contentTypes.posts.path), icon: contentTypes.posts.icon },
      { label: entry.data.title, icon: 'lucide:file-text' }
    ]}
  />
  {entry.data.cover && (
    <div class="mb-8 overflow-hidden rounded-[var(--radius-card)]">
      <img src={entry.data.cover} alt={entry.data.coverAlt || entry.data.title} class="aspect-video max-h-[60vh] w-full object-cover" loading="eager" />
    </div>
  )}
  <PostMeta
    title={entry.data.title}
    description={entry.data.description}
    date={entry.data.pubDate}
    updatedDate={entry.data.updatedDate}
    author={entry.data.author || siteConfig.person.name}
    authorUrl={entry.data.author ? entry.data.authorUrl : siteConfig.person.url}
    readingMinutes={readingMinutes}
    locale={locale}
    categories={entry.data.categories}
    tags={entry.data.tags}
    series={seriesContext ? {
      title: seriesContext.series.entry.data.title,
      href: localizedSeriesPath(seriesContext.series.entry),
      position: seriesContext.position,
      total: seriesContext.series.chapters.length
    } : undefined}
  />
  <article class="prose mb-12 max-w-none">
    <Content />
  </article>
  <PostLicense locale={locale} />
  <PostNavigation previous={adjacent.previous} next={adjacent.next} locale={locale} kind={seriesContext ? 'series' : 'post'} />
  <RelatedPosts posts={related} locale={locale} />
</BaseLayout>
