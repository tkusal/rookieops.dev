---
import { Icon } from 'astro-icon/components';
import type { Locale } from '../../config/i18n';
import { useTranslations } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div
  id="search-overlay"
  class="bg-background/70 pointer-events-none fixed inset-0 z-50 opacity-0 backdrop-blur-sm transition-opacity"
>
</div>
<section
  id="search-modal"
  data-locale={locale}
  class="border-border bg-popover pointer-events-none fixed top-20 left-1/2 z-50 w-[min(42rem,calc(100vw-2rem))] -translate-x-1/2 scale-95 rounded-lg border opacity-0 shadow-2xl transition"
  aria-hidden="true"
  inert
  tabindex="-1"
  role="dialog"
  aria-modal="true"
  aria-label={t('search.label')}
>
  <div class="border-border flex items-center gap-2 border-b px-3 py-2">
    <Icon name="lucide:search" class="text-muted-foreground h-4 w-4" />
    <label for="search-input" class="sr-only">{t('search.placeholder')}</label>
    <input
      id="search-input"
      type="search"
      class="min-h-11 min-w-0 flex-1 bg-transparent py-2 outline-none"
      placeholder={t('search.placeholder')}
      autocomplete="off"
      aria-controls="search-results"
    />
    <button
      id="search-close"
      type="button"
      class="hover:bg-accent grid h-11 w-11 shrink-0 place-items-center rounded-md"
      aria-label={t('search.close')}
    >
      <Icon name="lucide:x" class="h-4 w-4" />
    </button>
  </div>
  <div class="max-h-[60vh] overflow-auto p-2">
    <p id="search-empty" class="text-muted-foreground px-3 py-10 text-center text-sm">
      {t('search.empty')}
    </p>
    <p id="search-loading" class="text-muted-foreground hidden px-3 py-10 text-center text-sm">
      {t('search.loading')}
    </p>
    <p id="search-no-results" class="text-muted-foreground hidden px-3 py-10 text-center text-sm">
      {t('search.noResults')}
    </p>
    <div id="search-results" class="space-y-1" aria-live="polite"></div>
  </div>
</section>
