---
import { Icon } from 'astro-icon/components';
import type { Locale } from '../../config/i18n';
import type { ArchiveTerm } from '../../lib/content/entries';
import { useTranslations } from '../../i18n/utils';

interface Props {
  categories: ArchiveTerm[];
  tags: ArchiveTerm[];
  total: number;
  locale: Locale;
}

const { categories, tags, total, locale } = Astro.props;
const t = useTranslations(locale);
const difficultyLevels = ['Iniciante', 'Intermediário', 'Avançado'];
const difficultyValues = new Set(difficultyLevels);
const difficulties = difficultyLevels.flatMap((level) => {
  const term = tags.find(({ value }) => value === level);
  return term ? [term] : [];
});
const tagTerms = tags
  .filter(({ value }) => !difficultyValues.has(value))
  .sort((a, b) => b.count - a.count || a.value.localeCompare(b.value, 'pt-BR'));
const filterButtonClass =
  'inline-flex min-h-8 items-center rounded-full border border-border bg-card px-2.5 py-1 text-[0.6875rem] font-medium text-muted-foreground transition-colors duration-200 hover:border-primary/40 hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 focus-visible:ring-offset-2 focus-visible:ring-offset-background aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-foreground aria-pressed:hover:bg-primary aria-pressed:hover:text-primary-foreground motion-reduce:transition-none';
---

<section
  data-archive-filter-root
  hidden
  class="surface-panel mb-6 p-4 sm:p-5"
  aria-label={t('archive.filter.label')}
>
  <div class="space-y-3">
    <fieldset>
      <legend class="sr-only">{t('archive.filter.categories')}</legend>
      <div class="sm:grid sm:grid-cols-[5.5rem_minmax(0,1fr)] sm:items-start sm:gap-4">
        <span aria-hidden="true" class="text-xs font-semibold text-foreground sm:pt-2">
          {t('archive.filter.categories')}
        </span>
        <div class="mt-2 flex min-w-0 flex-wrap gap-1 sm:mt-0">
          <button
            type="button"
            data-archive-filter-kind="category"
            data-archive-filter-value=""
            aria-pressed="true"
            aria-controls="archive-results"
            class={filterButtonClass}
          >
            {t('archive.filter.all')}
          </button>
          {categories.map((term) => (
            <button
              type="button"
              data-archive-filter-kind="category"
              data-archive-filter-value={term.value}
              aria-pressed="false"
              aria-controls="archive-results"
              class={filterButtonClass}
            >
              {term.value}
            </button>
          ))}
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend class="sr-only">{t('archive.filter.difficulty')}</legend>
      <div class="sm:grid sm:grid-cols-[5.5rem_minmax(0,1fr)] sm:items-start sm:gap-4">
        <span aria-hidden="true" class="text-xs font-semibold text-foreground sm:pt-2">
          {t('archive.filter.difficulty')}
        </span>
        <div class="mt-2 flex min-w-0 flex-wrap gap-1 sm:mt-0">
          <button
            type="button"
            data-archive-filter-kind="difficulty"
            data-archive-filter-value=""
            aria-pressed="true"
            aria-controls="archive-results"
            class={filterButtonClass}
          >
            {t('archive.filter.allDifficulty')}
          </button>
          {difficulties.map((term) => (
            <button
              type="button"
              data-archive-filter-kind="difficulty"
              data-archive-filter-value={term.value}
              aria-pressed="false"
              aria-controls="archive-results"
              class={filterButtonClass}
            >
              {term.value}
            </button>
          ))}
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend class="sr-only">{t('archive.filter.tags')}</legend>
      <div class="sm:grid sm:grid-cols-[5.5rem_minmax(0,1fr)] sm:items-start sm:gap-4">
        <span aria-hidden="true" class="text-xs font-semibold text-foreground sm:pt-3">
          {t('archive.filter.tags')}
        </span>
        <div data-archive-tag-select class="relative mt-2 min-w-0 sm:mt-0">
          <button
            type="button"
            data-archive-tag-toggle
            aria-expanded="false"
            aria-controls="archive-tag-panel"
            aria-haspopup="true"
            class="flex min-h-11 w-full items-center justify-between gap-3 rounded-[var(--radius-control)] border border-border bg-card px-3 py-2 text-left text-sm font-medium text-foreground shadow-sm transition-colors hover:border-primary/40 hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 focus-visible:ring-offset-2 focus-visible:ring-offset-background sm:max-w-sm"
          >
            <span class="flex min-w-0 items-center gap-2">
              <Icon name="lucide:tags" class="h-4 w-4 shrink-0 text-muted-foreground" />
              <span data-archive-tag-summary class="truncate">{t('archive.filter.chooseTags')}</span>
            </span>
            <span class="flex shrink-0 items-center gap-2">
              <span data-archive-tag-badge hidden class="min-w-5 rounded-full bg-primary px-1.5 py-0.5 text-center text-[0.6875rem] font-semibold text-primary-foreground"></span>
              <Icon data-archive-tag-chevron name="lucide:chevron-down" class="h-4 w-4 text-muted-foreground transition-transform" />
            </span>
          </button>

          <div
            id="archive-tag-panel"
            data-archive-tag-panel
            hidden
            class="mt-2 rounded-[var(--radius-card)] border border-border bg-popover p-2 shadow-[var(--surface-shadow-strong)] sm:absolute sm:left-0 sm:z-20 sm:w-96"
          >
            <label class="relative block">
              <span class="sr-only">{t('archive.filter.searchTags')}</span>
              <Icon name="lucide:search" class="pointer-events-none absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
              <input
                type="search"
                data-archive-tag-search
                placeholder={t('archive.filter.searchTags')}
                autocomplete="off"
                class="min-h-10 w-full rounded-[var(--radius-control)] border border-border bg-background py-2 pr-3 pl-9 text-sm text-foreground outline-none placeholder:text-muted-foreground focus:border-primary/50 focus:ring-2 focus:ring-primary/30"
              />
            </label>

            <div data-archive-tag-options class="mt-2 max-h-64 space-y-0.5 overflow-y-auto" aria-label={t('archive.filter.tags')}>
              {tagTerms.map((term) => (
                <label
                  data-archive-tag-row
                  data-archive-tag-label={term.value}
                  data-archive-tag-count={term.count}
                  class="flex min-h-10 cursor-pointer items-center gap-3 rounded-[var(--radius-control)] px-2.5 py-2 text-sm text-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
                >
                  <input
                    type="checkbox"
                    data-archive-filter-kind="tag"
                    data-archive-filter-value={term.value}
                    aria-controls="archive-results"
                    class="h-4 w-4 shrink-0 accent-primary"
                  />
                  <span class="min-w-0 flex-1 truncate">{term.value}</span>
                  <span data-archive-filter-count class="shrink-0 text-xs tabular-nums text-muted-foreground">
                    {term.count}
                  </span>
                </label>
              ))}
            </div>

            <p data-archive-tag-unavailable hidden class="px-3 py-4 text-center text-sm text-muted-foreground">
              {t('archive.filter.noTags')}
            </p>
            <p data-archive-tag-no-results hidden class="px-3 py-4 text-center text-sm text-muted-foreground">
              {t('archive.filter.noTagResults')}
            </p>
          </div>
        </div>
      </div>
    </fieldset>
  </div>

  <p data-archive-filter-notice hidden role="status" class="mt-4 rounded-[var(--radius-control)] bg-muted px-3 py-2 text-xs text-muted-foreground"></p>

  <div data-archive-active hidden class="mt-3 border-t border-border pt-3">
    <div class="flex flex-wrap items-center gap-2">
      <span class="mr-1 text-xs font-semibold text-foreground">{t('archive.filter.active')}</span>
      <div data-archive-active-list class="flex min-w-0 flex-1 flex-wrap gap-1"></div>
      <button
        type="button"
        data-archive-clear
        class="min-h-8 rounded-[var(--radius-control)] px-2 py-1 text-[0.6875rem] font-semibold text-primary transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
      >
        {t('archive.filter.clear')}
      </button>
    </div>
  </div>

  <div class="mt-3 border-t border-border pt-3 text-sm text-muted-foreground">
    <p aria-live="polite" aria-atomic="true">
      <strong data-archive-result-count class="font-semibold text-foreground">{total}</strong>{' '}
      <span data-archive-result-label>
        {total === 1 ? t('archive.results.foundSingle') : t('archive.results.foundPlural')}
      </span>
    </p>
    <p data-archive-empty hidden class="mt-3 rounded-[var(--radius-control)] bg-muted px-4 py-3 text-foreground">
      {t('archive.filter.empty')}
    </p>
  </div>
</section>

<script is:inline define:vars={{
  chooseTagsLabel: t('archive.filter.chooseTags'),
  selectedTagLabel: t('archive.filter.selectedTag'),
  selectedTagsLabel: t('archive.filter.selectedTags'),
  removedTagsNotice: t('archive.filter.removedTags'),
  removeFilterLabel: t('archive.filter.remove'),
  foundSingleLabel: t('archive.results.foundSingle'),
  foundPluralLabel: t('archive.results.foundPlural')
}}>
  window.archiveFilterLabels = {
    chooseTags: chooseTagsLabel,
    selectedTag: selectedTagLabel,
    selectedTags: selectedTagsLabel,
    removedTags: removedTagsNotice,
    removeFilter: removeFilterLabel,
    foundSingle: foundSingleLabel,
    foundPlural: foundPluralLabel
  };
</script>
<script>
  import '../../scripts/archive-filters.ts';
</script>
