---
import type { CollectionEntry } from 'astro:content';
import { localeMeta, type Locale } from '../../config/i18n';
import { formatDate, localizedEntryPath } from '../../lib/content/entries';

interface Props {
  posts: Array<CollectionEntry<'posts'>>;
  locale: Locale;
}

const { posts, locale } = Astro.props;
const monthFormatter = new Intl.DateTimeFormat(localeMeta[locale].dateLocale, {
  month: 'long',
  timeZone: 'UTC'
});
const groupedPosts = posts.reduce<Record<string, Record<string, Array<CollectionEntry<'posts'>>>>>(
  (acc, entry) => {
    const year = String(entry.data.pubDate.getUTCFullYear());
    const month = String(entry.data.pubDate.getUTCMonth() + 1).padStart(2, '0');
    acc[year] ||= {};
    acc[year][month] ||= [];
    acc[year][month].push(entry);
    return acc;
  },
  {}
);
const groups = Object.entries(groupedPosts)
  .sort(([left], [right]) => Number(right) - Number(left))
  .map(([year, months]) => ({
    year,
    months: Object.entries(months)
      .sort(([left], [right]) => Number(right) - Number(left))
      .map(([month, entries]) => ({
        month,
        label: monthFormatter.format(new Date(Date.UTC(2000, Number(month) - 1, 1))),
        entries
      }))
  }));
---

<div id="archive-results" class="relative mt-10">
  <div class="bg-border absolute top-2 bottom-0 left-4 w-px"></div>
  <div class="space-y-10">
    {
      groups.map(({ year, months }) => (
        <section data-archive-year={year} class="relative pl-12">
          <div class="bg-primary text-primary-foreground absolute top-1 left-0 grid h-8 w-8 place-items-center rounded-[var(--radius-panel)] text-xs font-semibold shadow-sm">
            {year.slice(2)}
          </div>
          <h2 class="text-2xl font-semibold">{year}</h2>
          <div class="mt-5 space-y-6">
            {months.map(({ month, label, entries }) => (
              <section data-archive-month={`${year}-${month}`}>
                <h3 class="text-muted-foreground mb-2 text-sm font-semibold tracking-wide capitalize">
                  {label}
                </h3>
                <div class="surface-panel divide-border divide-y overflow-hidden">
                  {entries.map((entry) => (
                    <a
                      href={localizedEntryPath('posts', entry as any)}
                      data-archive-entry
                      data-categories={JSON.stringify(entry.data.categories || [])}
                      data-tags={JSON.stringify(entry.data.tags || [])}
                      class="hover:bg-accent focus-visible:ring-primary/35 grid gap-1 p-4 transition-colors duration-200 focus-visible:ring-2 focus-visible:outline-none focus-visible:ring-inset motion-reduce:transition-none sm:grid-cols-[9rem_1fr] sm:items-center"
                    >
                      <time class="text-muted-foreground text-sm">
                        {formatDate(entry.data.pubDate, locale)}
                      </time>
                      <div>
                        <h4 class="font-medium">{entry.data.title}</h4>
                        {entry.data.description && (
                          <p class="text-muted-foreground mt-1 text-sm">{entry.data.description}</p>
                        )}
                      </div>
                    </a>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</div>
