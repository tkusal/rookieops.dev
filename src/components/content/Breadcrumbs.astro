---
import { Icon } from 'astro-icon/components';
import type { Locale } from '../../config/i18n';
import { useTranslations } from '../../i18n/utils';

export interface BreadcrumbItem {
  label: string;
  href?: string;
  icon?: string;
}

interface Props {
  items: BreadcrumbItem[];
  locale: Locale;
}

const { items, locale } = Astro.props;
const t = useTranslations(locale);
const ariaLabel = t('breadcrumbs.label');
---

{
  items.length > 0 && (
    <nav class="mb-5 overflow-x-auto py-1" aria-label={ariaLabel}>
      <ol class="text-muted-foreground flex items-center gap-1 text-sm whitespace-nowrap">
        {items.map((item, index) => {
          const isLast = index === items.length - 1;
          return (
            <li class="flex min-w-0 items-center gap-1">
              {index > 0 && (
                <Icon
                  name="lucide:chevron-right"
                  class="text-muted-foreground/55 h-3.5 w-3.5 shrink-0"
                />
              )}
              {isLast || !item.href ? (
                <span class="text-foreground inline-flex min-w-0 items-center gap-1.5 px-1.5 py-1 font-medium">
                  {item.icon && <Icon name={item.icon} class="h-3.5 w-3.5 shrink-0" />}
                  <span class="max-w-48 truncate sm:max-w-80">{item.label}</span>
                </span>
              ) : (
                <a
                  href={item.href}
                  class="text-muted-foreground hover:bg-accent hover:text-accent-foreground inline-flex min-h-8 items-center gap-1.5 rounded-[var(--radius-control)] px-2 py-1 transition-colors duration-200"
                >
                  {item.icon && <Icon name={item.icon} class="h-3.5 w-3.5 shrink-0" />}
                  <span>{item.label}</span>
                </a>
              )}
            </li>
          );
        })}
      </ol>
    </nav>
  )
}
