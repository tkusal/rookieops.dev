---
import '../../styles/global.css';
import { localeMeta, type Locale } from '../../config/i18n';
import { siteConfig } from '../../config/site';
import { defaultTheme } from '../../config/theme';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Dock from '../ui/Dock.astro';
import SearchModal from '../features/SearchModal.astro';
import Toc from '../features/Toc.astro';
import Comments from '../features/Comments.astro';
import Analytics from '../features/Analytics.astro';
import GalleryLightbox from '../features/GalleryLightbox.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  type?: 'website' | 'article';
  image?: string;
  imageAlt?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: {
    name: string;
    url?: string;
  };
  tags?: string[];
  categories?: string[];
  breadcrumbs?: Array<{ name: string; item?: string }>;
  noindex?: boolean;
  headings?: Heading[];
  toc?: boolean | 'center' | 'side';
  comments?: boolean;
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  locale = 'pt-br',
  type = 'website',
  image = '/og.png',
  imageAlt = `${siteConfig.name} — ${siteConfig.author.title[locale]} ${siteConfig.author.tagline[locale]}`,
  publishedTime,
  modifiedTime,
  author,
  tags = [],
  categories = [],
  breadcrumbs = [],
  noindex = false,
  headings = [],
  toc = false,
  comments = false
} = Astro.props;

const pageTitle = title === siteConfig.name ? siteConfig.seoTitle : `${title} | ${siteConfig.name}`;
const htmlLang = localeMeta[locale].htmlLang;
const assetBase = import.meta.env.BASE_URL || '/';
const normalizedAssetBase = assetBase.replace(/\/?$/, '/');
const faviconSvg = `${normalizedAssetBase}favicon.svg`;
const siteOrigin = Astro.site?.origin || Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const socialImagePath = image.startsWith('/') ? image.slice(1) : image;
const socialImageUrl = /^(https?:)?\/\//.test(image)
  ? new URL(image, siteOrigin).toString()
  : new URL(`${normalizedAssetBase}${socialImagePath}`, siteOrigin).toString();
const hasDefaultSocialImage = image === '/og.png';
const rssUrl = new URL(`${normalizedAssetBase}rss.xml`, siteOrigin).toString();
const homeUrl = new URL(normalizedAssetBase, siteOrigin).toString();
const authorUrl = siteConfig.person.url;
const articleAuthor = author || {
  name: siteConfig.person.name,
  url: siteConfig.person.url
};
const isSiteAuthor = articleAuthor.name === siteConfig.person.name
  && articleAuthor.url === siteConfig.person.url;
const pageAuthorName = type === 'article' ? articleAuthor.name : siteConfig.person.name;
const pageAuthorUrl = type === 'article' ? articleAuthor.url : authorUrl;
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const socialUrls = siteConfig.person.social.map((item) => item.url);
const organizationId = `${homeUrl}#organization`;
const personId = `${authorUrl.replace(/\/?$/, '/')}#person`;
const websiteId = `${homeUrl}#website`;
const webpageId = `${canonicalUrl}#webpage`;
const structuredGraph = [
  {
    '@type': 'Organization',
    '@id': organizationId,
    name: siteConfig.organization.name,
    url: siteConfig.organization.url,
    logo: {
      '@type': 'ImageObject',
      url: new URL(faviconSvg, siteOrigin).toString()
    }
  },
  {
    '@type': 'Person',
    '@id': personId,
    name: siteConfig.person.name,
    url: authorUrl,
    sameAs: socialUrls
  },
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: homeUrl,
    name: siteConfig.name,
    description: siteConfig.description,
    inLanguage: htmlLang,
    publisher: { '@id': organizationId }
  },
  {
    '@type': type === 'article' ? 'BlogPosting' : 'WebPage',
    '@id': webpageId,
    url: canonicalUrl,
    name: pageTitle,
    headline: type === 'article' ? title : undefined,
    description,
    inLanguage: htmlLang,
    isPartOf: { '@id': websiteId },
    mainEntityOfPage: type === 'article' ? canonicalUrl : undefined,
    image: socialImageUrl,
    datePublished: type === 'article' ? publishedTime?.toISOString() : undefined,
    dateModified: type === 'article' ? (modifiedTime || publishedTime)?.toISOString() : undefined,
    author: type === 'article'
      ? (isSiteAuthor
          ? { '@id': personId }
          : {
              '@type': 'Person',
              name: articleAuthor.name,
              ...(articleAuthor.url ? { url: articleAuthor.url } : {})
            })
      : undefined,
    publisher: type === 'article' ? { '@id': organizationId } : undefined,
    keywords: type === 'article' ? [...categories, ...tags].join(', ') : undefined
  },
  ...(breadcrumbs.length > 1
    ? [{
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbs.map((breadcrumb, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: breadcrumb.name,
          ...(breadcrumb.item
            ? { item: new URL(breadcrumb.item, siteOrigin).toString() }
            : {})
        }))
      }]
    : [])
];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': structuredGraph
};
const themeInit = `
(() => {
  const root = document.documentElement;
  try {
    const theme = localStorage.getItem('theme') || '${defaultTheme}';
    const mode = localStorage.getItem('color-mode');
    const contentWidth = localStorage.getItem('content-width');
    root.dataset.theme = theme;
    if (contentWidth && /^\\d+(?:\\.\\d+)?rem$/.test(contentWidth)) {
      root.style.setProperty('--layout-content-width', contentWidth);
    }
    if (mode !== 'light') {
      root.classList.add('dark');
    }
  } catch {
    root.classList.add('dark');
  }
})();
`;
---

<!doctype html>
<html lang={htmlLang} data-theme={defaultTheme} style={`--layout-content-width: ${siteConfig.contentWidth}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content={pageAuthorName} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="theme-color" content="#34ffc9" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={htmlLang} href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    {pageAuthorUrl && <link rel="author" href={pageAuthorUrl} />}
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href={rssUrl} />
    <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    {hasDefaultSocialImage && <meta property="og:image:width" content="1200" />}
    {hasDefaultSocialImage && <meta property="og:image:height" content="630" />}
    {hasDefaultSocialImage && <meta property="og:image:type" content="image/png" />}
    <meta property="og:image:alt" content={imageAlt} />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === 'article' && (modifiedTime || publishedTime) && <meta property="article:modified_time" content={(modifiedTime || publishedTime)?.toISOString()} />}
    {type === 'article' && articleAuthor.url && <meta property="article:author" content={articleAuthor.url} />}
    {type === 'article' && categories.map((category) => <meta property="article:section" content={category} />)}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{pageTitle}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)}></script>
    <script is:inline set:html={themeInit}></script>
  </head>
  <body class="bg-background text-foreground min-h-screen antialiased">
    <div data-page-shell class="relative isolate mx-auto min-h-screen w-full max-w-[var(--layout-content-width)] px-4">
      <Header locale={locale} />
      <main>
        {toc && headings.length > 0 && <Toc headings={headings} position={toc === true ? 'center' : toc} />}
        <slot />
        {comments && <Comments />}
      </main>
      <Footer locale={locale} />
    </div>
    {siteConfig.ui.dock.enabled && <Dock locale={locale} />}
    <SearchModal locale={locale} />
    <GalleryLightbox locale={locale} />
    <Analytics />
    <script>
      import '../../scripts/theme-controls.ts';
      import '../../scripts/reading-progress.ts';
      import '../../scripts/toc.ts';
      import '../../scripts/mermaid.ts';
      import '../../scripts/dock.ts';
      import '../../scripts/tabs.ts';

      let searchModulePromise: Promise<typeof import('../../scripts/search.ts')> | undefined;
      const loadSearch = () => {
        searchModulePromise ||= import('../../scripts/search.ts');
        return searchModulePromise;
      };

      document.addEventListener('click', async (event) => {
        const target = event.target;
        if (!(target instanceof Element) || !target.closest('[data-search-open]')) return;
        const search = await loadSearch();
        search.openSearch();
      });

      document.addEventListener('keydown', async (event) => {
        if (!(event.metaKey || event.ctrlKey) || event.key.toLowerCase() !== 'k') return;
        event.preventDefault();
        const search = await loadSearch();
        search.openSearch();
      });

      if (document.querySelector('.markdown-gallery, .prose > .image-figure')) {
        void import('../../scripts/gallery.ts');
      }
    </script>
  </body>
</html>
