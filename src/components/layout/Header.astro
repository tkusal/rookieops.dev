---
import { Icon } from 'astro-icon/components';
import { getLocalePath, type Locale } from '../../config/i18n';
import { getNavigation } from '../../config/navigation';
import { siteConfig } from '../../config/site';
import { useTranslations } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const navigation = getNavigation(locale);
const currentPath = Astro.url.pathname;
const t = useTranslations(locale);
const headerClass = siteConfig.ui.navbar.sticky ? 'sticky top-5' : 'relative';

function isActive(href: string) {
  if (href === '/') return currentPath === href;
  return currentPath === href || currentPath.startsWith(href);
}

function isExternal(href: string) {
  return /^(https?:)?\/\//.test(href);
}
---

<header class:list={[headerClass, 'z-30 mt-5 mb-6']}>
  <div
    class="nav-shell flex min-h-16 items-center justify-between gap-3 border px-4 shadow-[var(--surface-shadow)]"
  >
    <a href={getLocalePath(locale, '/')} class="flex min-w-0 items-center gap-2 font-semibold">
      <img
        src="/favicon.svg"
        alt=""
        width="32"
        height="32"
        class="h-8 w-8 shrink-0 object-contain"
        aria-hidden="true"
      />
      <span class="truncate">{siteConfig.name}</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label={t('nav.primary')}>
      {
        navigation.map((item) => (
          <a
            class:list={[
              'nav-item inline-flex items-center gap-1.5 rounded-[var(--radius-control)] px-3 py-2 text-sm transition-colors duration-200',
              isActive(item.href)
                ? 'bg-accent text-accent-foreground'
                : 'text-muted-foreground hover:bg-accent hover:text-accent-foreground'
            ]}
            href={item.href}
            target={isExternal(item.href) ? '_blank' : undefined}
            rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
          >
            <Icon name={item.icon} class="h-4 w-4" />
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-1">
      <button
        type="button"
        data-search-open
        class="text-muted-foreground hover:bg-accent hover:text-accent-foreground grid h-11 w-11 place-items-center rounded-[var(--radius-control)] transition-colors"
        aria-label={t('nav.search')}
        title={t('nav.search')}
      >
        <Icon name="lucide:search" class="h-4 w-4" />
      </button>
      <button
        type="button"
        data-mobile-menu
        aria-expanded="false"
        class="hover:bg-accent grid h-11 w-11 place-items-center rounded-[var(--radius-control)] transition-colors md:hidden"
        aria-label={t('nav.menu')}
      >
        <Icon name="lucide:menu" class="h-4 w-4" />
      </button>
    </div>
  </div>
  <nav
    data-mobile-panel
    class="border-border bg-popover mt-2 hidden rounded-[var(--radius-card)] border p-2 shadow-[var(--surface-shadow-strong)] md:hidden"
    aria-label={t('nav.primaryMobile')}
  >
    {
      navigation.map((item) => (
        <a
          class:list={[
            'flex min-h-11 items-center gap-2 rounded-[var(--radius-control)] px-3 py-2 text-sm',
            isActive(item.href)
              ? 'bg-accent text-accent-foreground ring-primary/35 ring-1'
              : 'text-muted-foreground hover:bg-accent hover:text-accent-foreground'
          ]}
          href={item.href}
          target={isExternal(item.href) ? '_blank' : undefined}
          rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
        >
          <Icon name={item.icon} class="h-4 w-4" />
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
