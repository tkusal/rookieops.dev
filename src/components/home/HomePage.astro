---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import { getLocalePath, type Locale } from '../../config/i18n';
import type { ContentTypeId } from '../../config/content';
import { siteConfig } from '../../config/site';
import { useTranslations } from '../../i18n/utils';
import EntryList from '../content/EntryList.astro';
import ViewAll from '../ui/ViewAll.astro';
import ParticleBackground from '../features/ParticleBackground.astro';

interface HomeSection {
  id: ContentTypeId;
  title: string;
  href: string;
  entries: Array<CollectionEntry<'posts'> | CollectionEntry<'projects'>>;
}

interface Props {
  locale: Locale;
  sections: HomeSection[];
}

const { locale, sections } = Astro.props;
const { author } = siteConfig;
const t = useTranslations(locale);

function assetPath(path: string) {
  if (/^(https?:)?\/\//.test(path) || path.startsWith('data:')) return path;
  const base = import.meta.env.BASE_URL || '/';
  return `${base.replace(/\/?$/, '/')}${path.replace(/^\//, '')}`;
}

const avatarSrc = assetPath(author.avatar);
---

<ParticleBackground />

<section class="py-4 sm:py-10">
  <div
    class="profile-card border-border bg-background rounded-[var(--radius-card)] border px-5 py-5 shadow-[var(--surface-shadow)] sm:px-8 sm:py-6"
  >
    <div
      class="flex flex-col items-center gap-3 text-center sm:gap-6 md:flex-row md:items-start md:text-left"
    >
      <img
        src={avatarSrc}
        alt=""
        class="border-primary/20 h-16 w-16 shrink-0 rounded-full border-4 object-cover shadow-sm sm:h-24 sm:w-24"
      />

      <div class="min-w-0 flex-1">
        <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">{author.name}</h1>
        <p class="profile-slogan mt-1 text-base font-medium sm:mt-1.5 sm:text-lg">
          {author.title[locale]}
        </p>
        <p class="profile-slogan mt-1 hidden text-sm font-semibold sm:block">
          {author.tagline[locale]}
        </p>
        <p class="text-foreground mt-2 text-sm leading-relaxed sm:hidden">
          {author.mobileDescription[locale]}
        </p>
        <p class="text-foreground mt-3 hidden text-base leading-relaxed sm:block">
          {author.description[locale]}
        </p>

        <a
          href={getLocalePath(locale, '/posts/')}
          class="bg-primary text-primary-foreground hover:bg-primary/90 mt-4 inline-flex min-h-11 items-center justify-center gap-2 rounded-[var(--radius-control)] px-4 py-2 text-sm font-semibold shadow-sm transition-colors sm:hidden"
        >
          {t('home.readPosts')}
          <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </div>
</section>

{
  sections.map(
    (section) =>
      section.entries.length > 0 && (
        <section class="py-8">
          <div class="mb-3 flex items-end justify-between gap-4">
            <h2 class="text-2xl font-semibold">{section.title}</h2>
            <ViewAll href={section.href} locale={locale} />
          </div>
          <EntryList entries={section.entries} collection={section.id} locale={locale} />
        </section>
      )
  )
}
